    "test:usage": "node scripts/test-usage.mjs",
    "test:release": "node scripts/test-release.mjs",
    "test:status": "node scripts/test-status.mjs",
    "test:signals": "node scripts/test-signal.mjs",
    "test:debug": "node scripts/test-debug.mjs",
    "status": "node scripts/status.mjs",
    "debug": "node scripts/debug.mjs",
    "test:single-instance": "node scripts/test-single-instance.mjs",
    "test:native": "node scripts/test-native.mjs",
    "test:portable": "node scripts/test-portable.mjs",
    "profile": "node scripts/profile.mjs",
